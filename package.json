{
  "name": "physics-sim-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "高中物理 AI 交互仿真工作台",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm -F @psw/web dev",
    "dev:server": "pnpm -F @psw/server dev",
    "build": "pnpm -F @psw/web build",
    "start": "node apps/server/src/index.mjs",
    "test": "pnpm -F @psw/core test",
    "test:watch": "pnpm -F @psw/core test:watch",
    "typecheck": "pnpm -F @psw/core typecheck && pnpm -F @psw/web typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
